{
  "name": "worksite-report",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for tracking construction progress through daily reports",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "arch": "depcruise src",
    "check": "npm run typecheck && npm run lint && npm run arch && npm test",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:api": "jest --selectProjects api --runInBand",
    "test:all": "npm test && jest --selectProjects integration api --runInBand",
    "test:cov": "jest --selectProjects unit --coverage",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts --reset"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.3.0",
    "pino": "10.4.0",
    "prisma": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.2",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

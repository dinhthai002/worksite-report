# Copy to .env for local development. Values here are local placeholders, not secrets.

# Host port of the `db` service in docker-compose.yml. Change it if another PostgreSQL already uses 5432,
# and use the same port in DATABASE_URL below.
DB_PORT=5432

# PostgreSQL connection string (required). Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worksite_report

# HTTP port
PORT=3000

# How many days back a report can be created (BR-2)
BACKDATE_LIMIT_DAYS=365

# Time zone used to decide "today" (BR-2)
APP_TIME_ZONE=Asia/Ho_Chi_Minh

# pino log level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
